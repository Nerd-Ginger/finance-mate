# Normalise line endings so the repo behaves the same on Windows, macOS, and Linux.
* text=auto eol=lf

# gradlew is executed by /bin/sh. If it is ever checked out with CRLF endings it
# fails with a confusing "bad interpreter" error, so it must stay LF everywhere.
gradlew text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be line-ending converted.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
*.aab binary
*.apk binary
*.so binary
*.pdf binary
